<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Only take effect with a Developer ID signature (hardened runtime). -->
<plist version="1.0">
<dict>
    <!-- the microphone (Blurt-Mic mix, voice changer, noise gate) -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- the AI voice engine (PyTorch) is installed later, outside the signed app -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
